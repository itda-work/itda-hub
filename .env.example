# 잇다 허브 환경변수. `just env` 가 이 파일을 복사해 .env 를 만들고 빈 비밀 값을 채운다.
# .env 는 커밋하지 않는다. 운영 서버에는 값을 채운 .env 만 둔다.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 호스트에서 uv 로 직접 띄울 때의 DB. compose 는 /data/hub.sqlite3(볼륨)로 덮어쓴다.
DATABASE_URL=sqlite:///db.sqlite3

# --- 공개 주소 ---
# OAuth 발급자(issuer)·보호 리소스(resource)의 뿌리. https 면 쿠키·프록시 헤더가 https 전제로 바뀐다.
# 운영 예: HUB_BASE_URL=https://hub.itda.work · HUB_MCP_URL=https://hub.itda.work/mcp (프록시가 /mcp 를 mcp:8080 으로)
HUB_BASE_URL=http://localhost:8000
HUB_MCP_URL=http://localhost:8080/mcp
# compose 가 127.0.0.1 에 여는 호스트 포트. 다른 것이 쓰고 있으면 바꾸고 위 두 주소도 같이 맞춘다.
HUB_WEB_PORT=8000
HUB_MCP_PORT=8080

# --- 로그인 ---
# 1: 이메일+비밀번호 로그인·회원가입(로컬·자체 호스팅). 0: Google 만(아래 자격 필수).
HUB_LOCAL_LOGIN=1
# 부트스트랩이 만드는 관리자 — 둘 다 있을 때만. 이미 있으면 비밀번호를 바꾸지 않는다.
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- 비밀 키 ---
# 도구 설정 값(사용자 API 키 등) 암호화 — Fernet. 한 번 정하면 바꾸지 않는다(바꾸면 저장된 값을 풀 수 없다).
HUB_SETTINGS_ENCRYPTION_KEY=
# MCP 프로세스가 허브의 introspection 을 부를 때 쓰는 리소스 서버 자격. 부트스트랩이 같은 값으로 Application 을 만든다.
HUB_INTROSPECTION_CLIENT_ID=hub-mcp
HUB_INTROSPECTION_CLIENT_SECRET=

# --- 관리자 공용 키(강의용) — 도구별. 비우면 사용자 개인 키만 허용된다. ---
SHARED_KOSIS_API_KEY=
