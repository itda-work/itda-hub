# 잇다 허브 환경변수. `just env` 가 이 파일을 복사해 .env 를 만들고 빈 비밀 값을 채운다.
# .env 는 커밋하지 않는다. 운영 서버에는 값을 채운 .env 만 둔다.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 호스트에서 uv 로 직접 띄울 때의 DB. compose 는 /data/hub.sqlite3(볼륨)로 덮어쓴다.
DATABASE_URL=sqlite:///db.sqlite3

# --- 공개 주소 ---
# OAuth 발급자(issuer)·보호 리소스(resource)의 뿌리. https 면 쿠키·프록시 헤더가 https 전제로 바뀐다.
# 운영 예: HUB_BASE_URL=https://hub.itda.work · HUB_MCP_URL=https://hub.itda.work/mcp (프록시가 /mcp 를 mcp:8080 으로)
HUB_BASE_URL=http://localhost:8000
HUB_MCP_URL=http://localhost:8080/mcp
# web(gunicorn) 워커 수. 유휴 실측 워커당 약 60 MiB. 메모리가 작은 호스트(1 GiB)는 1.
WEB_CONCURRENCY=2
# compose 가 127.0.0.1 에 여는 호스트 포트. 다른 것이 쓰고 있으면 바꾸고 위 두 주소도 같이 맞춘다.
HUB_WEB_PORT=8000
HUB_MCP_PORT=8080

# --- 로그인 ---
# 1: 이메일+비밀번호 로그인. Google 자격이 없으면(로컬·자체 호스팅) 이메일+비밀번호 가입도 열린다.
#    Google 자격이 있으면 가입은 Google 로만 — 이 값은 이미 있는 로컬 계정(비상용 관리자)의 로그인만 뜻한다.
# 0: Google 만(아래 자격 필수).
HUB_LOCAL_LOGIN=1
# 부트스트랩이 만드는 관리자 — 둘 다 있을 때만. 이미 있으면 비밀번호를 바꾸지 않는다.
HUB_ADMIN_EMAIL=admin@example.com
HUB_ADMIN_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- 비밀 키 ---
# 도구 설정 값(사용자 API 키 등) 암호화 — Fernet. 한 번 정하면 바꾸지 않는다(바꾸면 저장된 값을 풀 수 없다).
HUB_SETTINGS_ENCRYPTION_KEY=
# MCP 프로세스가 허브의 introspection 을 부를 때 쓰는 리소스 서버 자격. 부트스트랩이 같은 값으로 Application 을 만든다.
HUB_INTROSPECTION_CLIENT_ID=hub-mcp
HUB_INTROSPECTION_CLIENT_SECRET=

# --- 운영(hub.itda.work — 웹사이트 VM 동거) ---
# 위 값을 이렇게 바꾼다. compose.prod.yml 오버레이로 띄우고, 앞의 Caddy 가 HTTPS 를 종단한다(docs/deploy.md).
#   HUB_BASE_URL=https://hub.itda.work          # OAuth issuer(RFC 8414). 바꾸면 모든 커넥터가 재연결된다
#   HUB_MCP_URL=https://hub.itda.work/mcp       # 보호 리소스(RFC 9728). Caddy 가 /mcp 를 hub-mcp:8080 으로
#   DJANGO_ALLOWED_HOSTS=hub.itda.work          # compose 가 내부 호출용 hub-web 을 덧붙인다
#   DJANGO_CSRF_TRUSTED_ORIGINS=                # 비우면 HUB_BASE_URL 하나. 다른 오리진이 폼을 올릴 때만 쉼표로 추가
#   DJANGO_DEBUG=0
#   HUB_LOCAL_LOGIN=1                           # 비상용 이메일+비밀번호 로그인을 Google 과 병행(기존 계정만 — 비밀번호 가입은 닫힌다). 0 이면 Google 만
#   HUB_HSTS_SECONDS=31536000                   # (선택) HSTS max-age. 기본 1년 · includeSubDomains(hub.itda.work 아래만)
#   GOOGLE_OAUTH_CLIENT_ID=… GOOGLE_OAUTH_CLIENT_SECRET=…
#                                               # 옛 사이트의 OAuth 클라이언트 재사용. 리디렉션 URI
#                                               # https://hub.itda.work/accounts/google/login/callback/ 이 등록돼 있어야 한다
#   HUB_SETTINGS_ENCRYPTION_KEY=…               # 한 번 정하면 불변. 바꾸면 저장된 도구 설정(API 키)을 전부 풀 수 없다
#   WEB_CONCURRENCY=1                           # compose.prod.yml 기본값도 1
#   HUB_BACKUP_DIR=/opt/itda-backups/hub        # hub-backup 이 사본을 둘 호스트 디렉터리(uid 10001 쓰기 가능)
#   HUB_BACKUP_KEEP_DAYS=14
# 프록시는 X-Forwarded-Proto: https 를 붙이고 Host 를 그대로 넘겨야 한다(Caddy 기본 동작). HUB_BASE_URL 이 https 면
# 설정이 그 헤더를 신뢰하고(SECURE_PROXY_SSL_HEADER) 세션·CSRF 쿠키를 Secure 로 낸다.

# --- 관리자 공용 키(강의용) — 도구별. 비우면 사용자 개인 키만 허용된다. ---
SHARED_KOSIS_API_KEY=
