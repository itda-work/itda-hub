# 잇다 허브 환경변수 — 실제 값은 배포 환경에만 둔다. 이 파일은 이름과 형식만 보여 준다.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=hub.itda.work
DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.itda.work
DATABASE_URL=sqlite:////data/hub.sqlite3

# 허브 공개 주소 — OAuth 발급자(issuer)와 보호 리소스(resource) URL 의 뿌리. 바꾸면 모든 커넥터를 재연결해야 한다.
HUB_BASE_URL=https://hub.itda.work
# MCP 프로세스 공개 주소 — 교육생이 커스텀 커넥터에 입력하는 URL. 운영에서는 반드시 HUB_BASE_URL + /mcp (MCP 서버가 401 에 싣는 메타데이터 URL 이 HUB_BASE_URL 기준이다)
HUB_MCP_URL=https://hub.itda.work/mcp

# 사람 → 허브 로그인 (django-allauth Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 도구 설정 값(사용자 API 키 등) 암호화 키 — Fernet. `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
HUB_SETTINGS_ENCRYPTION_KEY=

# MCP 프로세스가 허브의 introspection 으로 토큰을 검증할 때 쓰는 리소스 서버 자격 (DOT Application, client_credentials)
HUB_INTROSPECTION_CLIENT_ID=
HUB_INTROSPECTION_CLIENT_SECRET=

# 관리자 공용 키(강의용) — 도구별. 비우면 사용자 개인 키만 허용된다.
SHARED_KOSIS_API_KEY=
